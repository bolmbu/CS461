OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=180
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Put an actual matching Piper ONNX and ONNX.json voice here. No voice is bundled.
PIPER_MODEL=
PIPER_LANGUAGE=en
DATA_DIR=runtime
RETENTION_DAYS=7
FAQ_THRESHOLD=0.17
SEMANTIC_THRESHOLD=0.55
# Frontend is same-machine only. Do not expose this prototype to a public network.
FRONTEND_ORIGIN=http://localhost:3000
